# Supabase — dane z panelu projektu (supabase.com) lub lokalnej instancji
# Lokalnie: uruchom `npx supabase start` żeby uzyskać te wartości
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Konto admina — odtwarzane automatycznie po każdym `npm run db:reset`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Whereby Embedded — klucz API z app.whereby.com/user/profile → API keys
WHEREBY_API_KEY=

# Konfiguracja biznesowa (kwoty w groszach: 5000 = 50,00 zł)
COMMISSION_RATE=0.20
PRICE_30_MIN_GROSZE=5000
PRICE_60_MIN_GROSZE=9000

# Vercel CLI — wymagane tylko do uruchomienia scripts/sync-env-vercel.mjs
# Token: vercel.com/account/tokens
# Project ID: Vercel → projekt → Settings → General
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
