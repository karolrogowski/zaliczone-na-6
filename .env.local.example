# Supabase — lokalna instancja (npx supabase start)
# Te klucze to lokalne domyślne wartości — bezpieczne tylko dla developmentu, NIE na produkcję
# Lokalnie: uruchom `npx supabase start` żeby uzyskać te wartości
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Whereby Embedded — klucz API z app.whereby.com/user/profile → API keys
WHEREBY_API_KEY=
